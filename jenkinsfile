pipeline {
    agent any
    environment { DOCKER_IMAGE = 'naouresbzeouich/Angular-resume-manager'  }
    stages {
        stage('Cloner le dépôt') {
            steps { branch:'main' ,git 'https://github.com/NaouresBzeouich/angular-TP2.git' }
        }
        stage('Construire DockerImage') {
            steps { script { sh 'docker build -t $DOCKER_IMAGE .'} }
        }
        stage('Pousser l image Docker'){
            steps{
                script{
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-creds',
                            passwordVariable: 'DOCKER_PASSWORD',
                            usernameVariable: 'DOCKER_USERNAME'
                            )
                        ])
                        {
                        sh 'docker login -u $DOCKER_USERNAME -p $DOCKER_PASSWORD'
                        sh 'docker push $DOCKER_IMAGE'
                        }
                }
            }
        }
        stage('Déployer sur Kubernetes') {
            steps {
                script {
                    sh 'kubectl apply -f deployment.yaml'
                    sh 'kubectl apply -f service.yaml'
                }
            }
        }
    }

}
